# Optional SEO & Analytics configuration for placementprepind.online
# Copy to .env.local and fill in values when setting up Google Search Console & GA4

# Canonical production domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.placementprepind.online

# Google Search Console HTML meta verification token (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
